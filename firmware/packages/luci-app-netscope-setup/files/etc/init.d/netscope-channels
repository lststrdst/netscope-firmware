#!/bin/sh /etc/rc.common
# Opt-in, bounded HY2 health checks. Never enabled by package installation.
START=98
STOP=10
USE_PROCD=1
start_service(){
  procd_open_instance channels
  # Supervise the actual controller; its process-scoped lock is not inherited by VPNs.
  procd_set_param command /usr/libexec/netscope-channels daemon
  procd_set_param respawn 3600 5 20
  procd_set_param term_timeout 15
  procd_set_param stdout 0
  procd_set_param stderr 1
  procd_close_instance
}
